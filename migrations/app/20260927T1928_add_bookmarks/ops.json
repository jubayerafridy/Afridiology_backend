        "sql": "CREATE TABLE \"public\".\"bookmark\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"starRating\" int4 DEFAULT 0 NOT NULL,\n  \"targetId\" int4 NOT NULL,\n  \"targetType\" text NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"userId\" int4 NOT NULL,\n  CONSTRAINT \"bookmark_pkey\" PRIMARY KEY (\"id\"),\n  CONSTRAINT \"bookmark_starRating_check\" CHECK ((\"starRating\" >= 0 AND \"starRating\" <= 5)),\n  CONSTRAINT \"bookmark_targetType_check\" CHECK ((\"targetType\" = ANY (ARRAY['CHAPTER'::text, 'LESSON'::text, 'CONCEPT'::text, 'EXECUTION'::text, 'CQ'::text, 'MCQ'::text])))\n)",
