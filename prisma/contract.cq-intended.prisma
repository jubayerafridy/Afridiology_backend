// use prisma-8
// Production contract for Afridiology.
// Run `pnpm prisma contract format` and then `pnpm prisma contract emit`.
model User {
  id                  Int                  @id(map: "user_pkey") @default(autoincrement())
  createdAt           Timestamptz          @default(now())
  email               String               @unique(map: "user_email_key")
  emailVerified       Boolean              @default(false)
  name                String
  passwordHash        String
  role                String               @default("STUDENT")
  status              String               @default("ACTIVE")
  updatedAt           Timestamptz          @default(now())

  authIdentities      AuthIdentity[]
  authSessions        AuthSession[]
  bookmarks           Bookmark[]
  bookmarkCollections BookmarkCollection[]
  questionProgress    QuestionProgress[]

  @@index([role], name: "user_role_idx")
  @@index([status], name: "user_status_idx")

  @@check(expression: "(role = ANY (ARRAY['STUDENT'::text, 'TEACHER'::text, 'AUTHOR'::text, 'MODERATOR'::text, 'ADMIN'::text, 'SUPER_ADMIN'::text]))", name: "user_role_check_2d5baecb")

  @@check(expression: "(status = ANY (ARRAY['ACTIVE'::text, 'SUSPENDED'::text, 'DEACTIVATED'::text]))", name: "user_status_check_5dec1c59")

  @@map("user")
}

model AuthIdentity {
  id         Int         @id(map: "authIdentity_pkey") @default(autoincrement())
  createdAt  Timestamptz @default(now())
  provider   String
  providerId String
  updatedAt  Timestamptz @default(now())
  userId     Int

  user       User        @relation(fields:[userId], references:[id], map: "authIdentity_userId_fkey")

  @@unique([provider, providerId], map: "authIdentity_provider_providerId_key")
  @@index([userId], name: "authIdentity_userId_idx")

  @@check(expression: "(provider = ANY (ARRAY['GOOGLE'::text, 'FACEBOOK'::text]))", name: "authIdentity_provider_check_ff14e296")

  @@map("authIdentity")
}

model AuthSession {
  id        Int          @id(map: "authSession_pkey") @default(autoincrement())
  createdAt Timestamptz  @default(now())
  expiresAt Timestamptz
  revokedAt Timestamptz?
  tokenHash String       @unique(map: "authSession_tokenHash_key")
  updatedAt Timestamptz  @default(now())
  userId    Int

  user      User         @relation(fields:[userId], references:[id], map: "authSession_userId_fkey")

  @@index([expiresAt], name: "authSession_expiresAt_idx")
  @@index([userId], name: "authSession_userId_idx")

  @@map("authSession")
}

model QuestionPaper {
  id           Int         @id(map: "questionPaper_pkey") @default(autoincrement())
  board        String?
  class        String
  createdAt    Timestamptz @default(now())
  institution  String?
  isActive     Boolean     @default(true)
  questionType String
  source       String
  subjectId    Int
  updatedAt    Timestamptz @default(now())
  year         Int?

  cQS          CQ[]
  mCQS         MCQ[]

  @@index([subjectId], name: "questionPaper_subjectId_idx")

  @@check(expression: "(\"questionType\" = ANY (ARRAY['CQ'::text, 'MCQ'::text]))", name: "questionPaper_questionType_check_fc2fe208")

  @@check(expression: "(source = ANY (ARRAY['BOARD'::text, 'TEST_PAPER'::text, 'MODEL_TEST'::text, 'GAME'::text, 'QUIZ'::text, 'EXTRA'::text]))", name: "questionPaper_source_check_4f230989")

  @@map("questionPaper")
}

model CQ {
  id              Int           @id(map: "cQ_pkey") @default(autoincrement())

  createdAt       Timestamptz   @default(now())
  updatedAt       Timestamptz   @default(now())
  isActive        Boolean       @default(false)

  point           Int?
  ytLink          String?

  questionPaperId Int
  qusNo           Int?

  descriptionBN   Json
  descriptionEng  Json
  quesUddipok     String?
  imageUrl        String?

  // ক
  quesKaBN        String
  quesKaEng       String
  quesKaLinkId    Int?
  quesKaLinkType  String?
  ansKaBN         String?
  ansKaEng        String?

  // খ
  quesKhaBN       String
  quesKhaEng      String
  quesKhaLinkId   Int?
  quesKhaLinkType String?
  ansKhaBN        String?
  ansKhaEng       String?

  // গ
  quesGaBN        String
  quesGaEng       String
  quesGaLinkId    Int?
  quesGaLinkType  String?
  ansGaBN         String?
  ansGaEng        String?

  // ঘ — optional
  quesGhaBN       String?
  quesGhaEng      String?
  quesGhaLinkId   Int?
  quesGhaLinkType String?
  ansGhaBN        String?
  ansGhaEng       String?

  questionPaper   QuestionPaper @relation(fields:[questionPaperId], references:[id], map: "cQ_questionPaperId_fkey")

  @@index([quesKaLinkType, quesKaLinkId], name: "cQ_quesKaLinkType_quesKaLinkId_idx")
  @@index([quesKhaLinkType, quesKhaLinkId], name: "cQ_quesKhaLinkType_quesKhaLinkId_idx")
  @@index([quesGaLinkType, quesGaLinkId], name: "cQ_quesGaLinkType_quesGaLinkId_idx")
  @@index([quesGhaLinkType, quesGhaLinkId], name: "cQ_quesGhaLinkType_quesGhaLinkId_idx")

  @@index([questionPaperId], name: "cQ_questionPaperId_idx")

  @@check(expression: "(\"quesKaLinkType\" = ANY (ARRAY['CHAPTER'::text, 'LESSON'::text, 'CONCEPT'::text, 'EXECUTION'::text]))", name: "cQ_quesKaLinkType_check_0020e8a5")

  @@check(expression: "(\"quesKhaLinkType\" = ANY (ARRAY['CHAPTER'::text, 'LESSON'::text, 'CONCEPT'::text, 'EXECUTION'::text]))", name: "cQ_quesKhaLinkType_check_e93f81d1")

  @@check(expression: "(\"quesGaLinkType\" = ANY (ARRAY['CHAPTER'::text, 'LESSON'::text, 'CONCEPT'::text, 'EXECUTION'::text]))", name: "cQ_quesGaLinkType_check_d4dcebe0")

  @@check(expression: "(\"quesGhaLinkType\" = ANY (ARRAY['CHAPTER'::text, 'LESSON'::text, 'CONCEPT'::text, 'EXECUTION'::text]))", name: "cQ_quesGhaLinkType_check_4f0b21d6")

  @@map("cQ")
}

model EducationLevel {
  id        Int         @id(map: "educationLevel_pkey") @default(autoincrement())
  name      String
  createdAt Timestamptz @default(now())
  isActive  Boolean     @default(true)
  updatedAt Timestamptz @default(now())

  subjects  Subject[]

  @@map("educationLevel")
}

model Subject {
  id               Int            @id(map: "subject_pkey") @default(autoincrement())
  educationLevelId Int
  name             String
  createdAt        Timestamptz    @default(now())
  isActive         Boolean        @default(true)
  updatedAt        Timestamptz    @default(now())

  chapters         Chapter[]
  educationLevel   EducationLevel @relation(fields:[educationLevelId], references:[id], map: "subject_educationLevelId_fkey")

  @@index([educationLevelId], name: "subject_educationLevelId_idx")

  @@map("subject")
}

model Chapter {
  id             Int         @id(map: "chapter_pkey") @default(autoincrement())
  subjectId      Int
  createdAt      Timestamptz @default(now())

  descriptionBN  Json
  descriptionEng Json

  isActive       Boolean     @default(true)
  updatedAt      Timestamptz @default(now())

  nameBN         String
  nameEng        String
  chapterNo      Int

  lessons        Lesson[]
  subject        Subject     @relation(fields:[subjectId], references:[id], map: "chapter_subjectId_fkey")

  @@unique([subjectId, chapterNo], map: "chapter_subjectId_chapterNo_key")
  @@index([subjectId], name: "chapter_subjectId_idx")

  @@map("chapter")
}

model Lesson {
  id             Int         @id(map: "lesson_pkey") @default(autoincrement())
  chapterId      Int
  createdAt      Timestamptz @default(now())

  descriptionBN  Json
  descriptionEng Json

  isActive       Boolean     @default(true)

  nameBN         String
  nameEng        String

  updatedAt      Timestamptz @default(now())
  lessonNo       String?

  concepts       Concept[]
  chapter        Chapter     @relation(fields:[chapterId], references:[id], map: "lesson_chapterId_fkey")

  @@unique([chapterId, lessonNo], map: "lesson_chapterId_lessonNo_key")
  @@index([chapterId], name: "lesson_chapterId_idx")

  @@map("lesson")
}

model Concept {
  id             Int         @id(map: "concept_pkey") @default(autoincrement())
  createdAt      Timestamptz @default(now())

  descriptionBN  Json
  descriptionEng Json

  isActive       Boolean     @default(true)
  lessonId       Int

  nameBN         String
  nameEng        String

  updatedAt      Timestamptz @default(now())

  executions     Execution[]
  lesson         Lesson      @relation(fields:[lessonId], references:[id], map: "concept_lessonId_fkey")

  @@index([lessonId], name: "concept_lessonId_idx")

  @@map("concept")
}

model Execution {
  id             Int         @id(map: "execution_pkey") @default(autoincrement())
  conceptId      Int
  createdAt      Timestamptz @default(now())

  descriptionBN  Json
  descriptionEng Json

  isActive       Boolean     @default(true)

  nameBN         String
  nameEng        String

  updatedAt      Timestamptz @default(now())

  concept        Concept     @relation(fields:[conceptId], references:[id], map: "execution_conceptId_fkey")

  @@index([conceptId], name: "execution_conceptId_idx")

  @@map("execution")
}

model MCQ {
  id              Int           @id(map: "mCQ_pkey") @default(autoincrement())
  createdAt       Timestamptz   @default(now())

  descriptionBN   Json
  descriptionEng  Json

  explanationBN   String?
  explanationEng  String?

  imageUrl        String?
  isActive        Boolean       @default(true)

  linkId          Int?
  linkType        String?

  optionsBN       Json
  optionsEng      Json

  quesUddipok     String?
  questionPaperId Int
  qusNo           Int

  rightAnsBN      String
  rightAnsEng     String

  updatedAt       Timestamptz   @default(now())

  questionPaper   QuestionPaper @relation(fields:[questionPaperId], references:[id], map: "mCQ_questionPaperId_fkey")

  @@index([linkType, linkId], name: "mCQ_linkType_linkId_idx")
  @@index([questionPaperId], name: "mCQ_questionPaperId_idx")

  @@check(expression: "(\"linkType\" = ANY (ARRAY['CHAPTER'::text, 'LESSON'::text, 'CONCEPT'::text, 'EXECUTION'::text]))", name: "mCQ_linkType_check_5f57da78")

  @@map("mCQ")
}

model Bookmark {
  id              Int                      @id(map: "bookmark_pkey") @default(autoincrement())
  userId          Int
  targetType      String
  targetId        Int
  starRating      Int                      @default(0)
  createdAt       Timestamptz              @default(now())
  updatedAt       Timestamptz              @default(now())

  user            User                     @relation(fields:[userId], references:[id], onDelete: Cascade, map: "bookmark_userId_fkey")
  collectionItems BookmarkCollectionItem[]

  @@unique([userId, targetType, targetId], map: "bookmark_userId_targetType_targetId_key")
  @@index([userId, updatedAt], name: "bookmark_userId_updatedAt_idx")
  @@index([targetType, targetId], name: "bookmark_targetType_targetId_idx")

  @@check(expression: "((\"starRating\" >= 0) AND (\"starRating\" <= 5))", name: "bookmark_starRating_range_guard")

  @@check(expression: "(\"targetType\" = ANY (ARRAY['CHAPTER'::text, 'LESSON'::text, 'CONCEPT'::text, 'EXECUTION'::text, 'CQ'::text, 'MCQ'::text]))", name: "bookmark_targetType_guard")

  @@map("bookmark")
}

model QuestionProgress {
  id         Int         @id(map: "questionProgress_pkey") @default(autoincrement())
  userId     Int
  targetType String
  targetId   Int
  status     String
  createdAt  Timestamptz @default(now())
  updatedAt  Timestamptz @default(now())

  user       User        @relation(fields:[userId], references:[id], onDelete: Cascade, map: "questionProgress_userId_fkey")

  @@unique([userId, targetType, targetId], map: "questionProgress_userId_targetType_targetId_key")

  @@index([userId, updatedAt], name: "questionProgress_userId_updatedAt_idx")

  @@check(expression: "(\"targetType\" = ANY (ARRAY['CHAPTER'::text, 'LESSON'::text, 'CONCEPT'::text, 'EXECUTION'::text, 'CQ'::text, 'MCQ'::text]))", name: "questionProgress_targetType_guard")

  @@check(expression: "(status = ANY (ARRAY['NOT_STARTED'::text, 'IN_PROGRESS'::text, 'COMPLETED'::text]))", name: "questionProgress_status_guard")

  @@map("questionProgress")
}

model BookmarkCollection {
  id          Int                      @id(map: "bookmarkCollection_pkey") @default(autoincrement())
  userId      Int
  name        String
  color       String
  type        String
  defaultType String?
  sortOrder   Int                      @default(0)
  createdAt   Timestamptz              @default(now())
  updatedAt   Timestamptz              @default(now())

  user        User                     @relation(fields:[userId], references:[id], onDelete: Cascade, map: "bookmarkCollection_userId_fkey")
  items       BookmarkCollectionItem[]

  @@unique([userId, defaultType], map: "bookmarkCollection_userId_defaultType_key")
  @@index([userId], name: "bookmarkCollection_userId_idx")
  @@index([userId, sortOrder], name: "bookmarkCollection_userId_sortOrder_idx")

  @@check(expression: "(type = ANY (ARRAY['DEFAULT'::text, 'CUSTOM'::text]))", name: "bookmarkCollection_type_guard")

  @@check(expression: "(((type = 'DEFAULT'::text) AND (\"defaultType\" IS NOT NULL)) OR ((type = 'CUSTOM'::text) AND (\"defaultType\" IS NULL)))", name: "bookmarkCollection_defaultType_guard")

  @@map("bookmarkCollection")
}

model BookmarkCollectionItem {
  id           Int                @id(map: "bookmarkCollectionItem_pkey") @default(autoincrement())
  bookmarkId   Int
  collectionId Int
  createdAt    Timestamptz        @default(now())

  bookmark     Bookmark           @relation(fields:[bookmarkId], references:[id], onDelete: Cascade, map: "bookmarkCollectionItem_bookmarkId_fkey")
  collection   BookmarkCollection @relation(fields:[collectionId], references:[id], map: "bookmarkCollectionItem_collectionId_fkey")

  @@unique([bookmarkId, collectionId], map: "bookmarkCollectionItem_bookmarkId_collectionId_key")
  @@index([collectionId], name: "bookmarkCollectionItem_collectionId_idx")

  @@map("bookmarkCollectionItem")
}
